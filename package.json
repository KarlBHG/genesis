{
  "name": "alltikerfi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "index": "vite-node -c vitest.config.mts scripts/build-content-index.ts",
    "prebuild": "npm run index",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "check": "next typegen && tsc --noEmit --pretty false && vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "verify": "npm run check && npm run e2e"
  },
  "dependencies": {
